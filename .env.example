# Run npm run setup to create .env with a random API token.
# Optional MCP: run setup:mcp on the server; the backend also reads .env.mcp.
API_TOKEN=replace-with-at-least-32-random-characters
SERVER_HOST=127.0.0.1
SERVER_PORT=4310
DATABASE_PATH=./data/assistant.sqlite
BRIDGE_PORT=4311
# Development: direct loopback HTTP. Production clients: ssh.
TRANSPORT=http
SERVER_URL=http://127.0.0.1:4310
SSH_HOST=assistant-server
SSH_PORT=22
SSH_COMMAND=/opt/qiyi/bin/gateway
# Optional; normally use your ssh-agent or ~/.ssh/config.
SSH_IDENTITY_FILE=
# AI stays disabled until MODEL_BASE_URL and MODEL_NAME are configured.
# MODEL_BASE_URL includes /v1. An empty key is valid for a local provider.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_JSON_MODE=true
ADAPTER_CONFIG=./adapter.config.json
